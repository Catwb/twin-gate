# Static assets: fixed filenames, so no long-lived cache.
/assets/app.css
  Cache-Control: public, max-age=0, must-revalidate
/assets/app.js
  Cache-Control: public, max-age=0, must-revalidate
/assets/security.js
  Cache-Control: public, max-age=0, must-revalidate

# Security headers for static pages.
# /login and /mfa are served directly by Assets without passing through
# the Worker middleware, so their protection must be declared here too.
# Keep these values identical to src/lib/security.ts.
# NOTE: do not add interest-cohort=() here or in security.ts -
# FLoC was retired in favor of the Topics API and Chrome no longer
# recognizes that directive, which only produces a console warning.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'
