    "@simplewebauthn/server": "14.0.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261026.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "wrangler": "4.152.0"
  }
}
