{
  "name": "@sso/core",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.4",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json",
