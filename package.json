{
  "name": "sso-platform",
  "private": true,
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "preinstall": "node scripts/preinstall.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:core": "pnpm --filter @sso/core dev",
    "dev:gateway": "pnpm --filter @sso/gateway dev",
    "deploy:core": "pnpm --filter @sso/core deploy",
    "deploy:gateway": "pnpm --filter @sso/gateway deploy",
    "check": "node scripts/check-constraints.mjs",
    "verify": "pnpm -r typecheck && pnpm -r test && pnpm check"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ]
  }
}
